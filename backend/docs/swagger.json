{
    "schemes": [
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Ankle fracture classification API. Classifies fractures according to Danis-Weber, Lauge-Hansen, AO/OTA, and Bartonicek systems.",
        "title": "Anklyze API",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/jferrl/anklyze"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "api.anklyze.com",
    "basePath": "/",
    "paths": {
        "/api/analytics/distribution/{system}": {
            "get": {
                "description": "Returns detailed distribution for a specific classification system",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Analytics"
                ],
                "summary": "Get classification distribution",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Classification system (danis-weber, lauge-hansen, ao-ota)",
                        "name": "system",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "30 days ago",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "today",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Distribution data",
                        "schema": {
                            "$ref": "#/definitions/domain.ClassificationDistribution"
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/analytics/summary": {
            "get": {
                "description": "Returns aggregated classification statistics for a time period",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Analytics"
                ],
                "summary": "Get analytics summary",
                "parameters": [
                    {
                        "type": "string",
                        "default": "30 days ago",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "today",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Analytics summary",
                        "schema": {
                            "$ref": "#/definitions/domain.AnalyticsSummary"
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/analytics/trends": {
            "get": {
                "description": "Returns time-series classification data with configurable granularity",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Analytics"
                ],
                "summary": "Get classification trends",
                "parameters": [
                    {
                        "type": "string",
                        "default": "30 days ago",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "today",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "day",
                        "description": "Time granularity (day, week, month)",
                        "name": "granularity",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Trend data",
                        "schema": {
                            "$ref": "#/definitions/domain.TrendData"
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/classify": {
            "post": {
                "description": "Classifies an ankle fracture according to Danis-Weber, Lauge-Hansen, AO/OTA, and Bartonicek systems",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Classification"
                ],
                "summary": "Classify an ankle fracture",
                "parameters": [
                    {
                        "type": "string",
                        "default": "en",
                        "description": "Language (en, es)",
                        "name": "lang",
                        "in": "query"
                    },
                    {
                        "description": "Fracture input parameters",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.FractureInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Classification result",
                        "schema": {
                            "$ref": "#/definitions/domain.ClassificationResult"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Classification error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/options": {
            "get": {
                "description": "Returns localized form options for the classification form",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Classification"
                ],
                "summary": "Get form options",
                "parameters": [
                    {
                        "type": "string",
                        "default": "en",
                        "description": "Language (en, es)",
                        "name": "lang",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Form options",
                        "schema": {
                            "$ref": "#/definitions/api.FormOptions"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns the health status of the API",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Health status",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
