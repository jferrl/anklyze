# Anklyze Backend Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Database (Supabase)
# ===================
# Use the pooler connection string from Supabase Dashboard > Settings > Database
# Select "Transaction" mode and copy the URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ===================
# Supabase Auth
# ===================
# From Supabase Dashboard > Settings > API
SUPABASE_URL=https://[project-ref].supabase.co

# ===================
# Server Config
# ===================
PORT=8080
CORS_ALLOW_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=text

# ===================
# Gemini AI (Optional)
# ===================
# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_RATE=0.5
RATE_LIMIT_BURST=5
SESSION_MESSAGE_LIMIT=20
DAILY_QUOTA_PER_IP=100
