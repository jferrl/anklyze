# Anklyze Backend Environment Variables
# Copy this file to .env and fill in your values

# Anything other than "development" enforces production checks (auth, S3).
# Only development may run without SUPABASE_URL, which makes every request a mock admin.
APP_ENV=development

# ===================
# Database (PostgreSQL)
# ===================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anklyze?sslmode=disable

# ===================
# Supabase Auth
# ===================
# From Supabase Dashboard > Settings > API
SUPABASE_URL=https://[project-ref].supabase.co
# Optional: required for auth admin operations (role syncing)
SUPABASE_SERVICE_ROLE_KEY=

# ===================
# S3-Compatible Storage (RustFS / MinIO)
# ===================
# Endpoint: host:port without scheme (e.g., rustfs:9000 for internal Docker, or host:80 via Traefik)
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
STUDY_BUCKET_NAME=studies
S3_USE_SSL=false

# ===================
# Server Config
# ===================
PORT=8080
CORS_ALLOW_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=text
# Bearer token for /metrics. Unset: open in development, not served in production.
METRICS_TOKEN=
# CIDRs allowed to set X-Forwarded-For. Default: loopback and private ranges.
# TRUSTED_PROXIES=172.18.0.0/16
