# Anklyze Backend Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Database (Supabase)
# ===================
# Use the pooler connection string from Supabase Dashboard > Settings > Database
# Select "Transaction" mode and copy the URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ===================
# Supabase Auth
# ===================
# From Supabase Dashboard > Settings > API
SUPABASE_URL=https://[project-ref].supabase.co
# Optional: required for auth admin operations (role syncing)
SUPABASE_SERVICE_ROLE_KEY=

# ===================
# S3-Compatible Storage (RustFS / MinIO)
# ===================
# Endpoint: host:port without scheme (e.g., rustfs:9000 for internal Docker, or host:80 via Traefik)
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
STUDY_BUCKET_NAME=studies
S3_USE_SSL=false

# ===================
# Server Config
# ===================
PORT=8080
CORS_ALLOW_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=text
