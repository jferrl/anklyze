  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action of a view.",
      "html": "<button class=\"ds-btn-primary\">Start classifying</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:2px;background:var(--primary);color:var(--primary-foreground);font:500 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;transition:background-color .15s}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 90%,transparent)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
