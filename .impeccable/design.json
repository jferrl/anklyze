      "refersTo": "button-outline",
      "description": "Secondary and navigation actions such as Previous or Clear search.",
      "html": "<button class=\"ds-btn-outline\">Previous</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;height:36px;padding:8px 16px;border:1px solid var(--input);border-radius:2px;background:var(--background);color:var(--foreground);font:500 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;transition:background-color .15s}.ds-btn-outline:hover{background:var(--accent);color:var(--accent-foreground)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
