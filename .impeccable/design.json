      "description": "Text field on forms and list search.",
      "html": "<input class=\"ds-input\" placeholder=\"Search cases\">",
      "css": ".ds-input{height:36px;width:240px;padding:4px 12px;border:1px solid var(--input);border-radius:2px;background:var(--card);color:var(--foreground);font:400 14px Archivo,ui-sans-serif,system-ui,sans-serif;outline:none;transition:box-shadow .15s}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge-status",
      "description": "Case or study lifecycle status, in tables and titles.",
      "html": "<span class=\"ds-badge\"><span class=\"ds-dot\"></span>Published</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;padding:2px 6px;border:1px solid var(--border);border-radius:0;color:var(--foreground);font:400 12px/16px Archivo,ui-sans-serif,system-ui,sans-serif}.ds-dot{width:6px;height:6px;border-radius:9999px;background:var(--success)}"
    },
    {
      "name": "System Tabs",
      "kind": "nav",
      "description": "Switch a view between the four classification systems.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-on\"><i style=\"background:var(--sys-lh)\"></i>Lauge-Hansen</button><button class=\"ds-tab\"><i style=\"background:var(--sys-dw)\"></i>Danis-Weber</button><button class=\"ds-tab\"><i style=\"background:var(--sys-ao)\"></i>AO/OTA</button><button class=\"ds-tab\"><i style=\"background:var(--sys-bt)\"></i>Bartonicek</button></div>",
      "css": ".ds-tabs{display:flex;width:fit-content;gap:2px;padding:2px;border:1px solid var(--border);border-radius:2px;background:var(--card)}.ds-tab{display:flex;align-items:center;gap:8px;padding:6px 12px;border:0;border-radius:0;background:none;color:var(--muted-foreground);font:400 14px Archivo,ui-sans-serif,system-ui,sans-serif;transition:color .15s}.ds-tab i{width:8px;height:8px}.ds-tab:hover{color:var(--foreground)}.ds-tab.ds-on{background:var(--accent);color:var(--foreground);font-weight:500}.ds-tab:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Stat Group",
      "kind": "card",
      "refersTo": "stat-cell",
      "description": "Summary figures at the top of dashboards and reports.",
      "html": "<section class=\"ds-stats\"><div><p>Cases</p><b>24</b><small>12 published</small></div><div><p>Raters</p><b>6</b><small>All invited</small></div><div><p>Responses</p><b>132</b><small>91.7% complete</small></div><div><p>Fleiss kappa</p><b>0.61</b><small>Lauge-Hansen</small></div></section>",
      "css": ".ds-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;overflow:hidden;border:1px solid var(--border);border-radius:4px;background:var(--border);font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-stats div{background:var(--card);padding:16px}.ds-stats p{margin:0;font-size:14px;color:var(--muted-foreground)}.ds-stats b{display:block;margin-top:4px;font-size:24px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--foreground)}.ds-stats small{display:block;margin-top:4px;font-size:12px;color:var(--muted-foreground)}"
    },
    {
      "name": "Result Grid",
      "kind": "custom",
      "description": "The four system results of a classification, codes in the display voice.",
      "html": "<dl class=\"ds-result\"><div><dt><i style=\"background:var(--sys-lh)\"></i>Lauge-Hansen</dt><dd>SER</dd></div><div><dt><i style=\"background:var(--sys-dw)\"></i>Danis-Weber</dt><dd>B</dd></div><div><dt><i style=\"background:var(--sys-ao)\"></i>AO/OTA</dt><dd>44-B1.1</dd></div><div><dt><i style=\"background:var(--sys-bt)\"></i>Bartonicek</dt><dd class=\"ds-nc\">Not classifiable</dd></div></dl>",
      "css": ".ds-result{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:0;overflow:hidden;border:1px solid var(--border);border-radius:4px;background:var(--border);font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-result div{background:var(--card);padding:16px}.ds-result dt{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--muted-foreground)}.ds-result i{width:10px;height:10px}.ds-result dd{margin:12px 0 0;font-size:30px;font-weight:750;font-stretch:80%;letter-spacing:-.02em;line-height:1;color:var(--foreground)}.ds-result dd.ds-nc{font-size:24px;color:var(--muted-foreground)}"
    },
    {
